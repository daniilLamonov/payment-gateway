# ---- Скопировать на сервере в .env и заполнить реальными значениями ----

# Домен, на котором висит шлюз (без https://)
DOMAIN=pay.example.com
PROTOCOL=https
FRONTEND_URL=https://pay.example.com

# Прод: debug выключен, /docs и /redoc отключаются
DEBUG=False

# Вход в админку веб-панели.
# ВНИМАНИЕ: ADMIN_PASSWORD — это bcrypt-ХЕШ пароля, а не сам пароль
# (backend/app/core/auth.py проверяет его через passlib .verify()).
# Сгенерировать хеш (пароль вводится скрыто):
#   docker compose -f docker-compose.prod.yaml exec -it backend \
#     python -c "from passlib.context import CryptContext; from getpass import getpass; \
#                print(CryptContext(schemes=['bcrypt']).hash(getpass('Password: ')))"
# Вставлять без кавычек, знаки $ экранировать не нужно (значение идёт через env_file).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2b$12$ЗАМЕНИТЬ.НА.РЕАЛЬНЫЙ.BCRYPT.ХЕШ

# JWT
JWT_SECRET_KEY=<сгенерировать: openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=120

# База. DB_HOST в docker-compose.prod.yaml жёстко задан как shared-postgres,
# это отдельный контейнер Postgres в сети shared-network (см. infra/).
DB_HOST=shared-postgres
DB_PORT=5432
DB_NAME=payment_gateway
DB_USER=payment_admin
DB_PASSWORD=<сгенерировать: openssl rand -base64 24>

# Email для Let's Encrypt (уведомления об истечении сертификата)
CERTBOT_EMAIL=you@example.com
